# TMDB API Configuration
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY="your_tmdb_api_key_here"

# Note: Do not include quotes in the actual .env file
# Correct: TMDB_API_KEY=93bbcf4a92e0749987e9607fb28663a6
# Incorrect: TMDB_API_KEY="93bbcf4a92e0749987e9607fb28663a6"
